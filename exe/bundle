#!/usr/bin/env ruby
# bundle - stoned minimal Bundler implementation
# Implements: install, exec, version, check, list

require "rubygems"

BUNDLE_VERSION = "2.5.0.stoned"
GEM_SERVER = ENV["STONED_GEM_SERVER"] || "https://rubygems.org"
LOCKFILE   = "Gemfile.lock"
GEMFILE    = ENV["BUNDLE_GEMFILE"] || "Gemfile"

# ── Gemfile DSL ─────────────────────────────────────────────────────────────

class GemfileDSL
  attr_reader :dependencies, :sources, :ruby_version, :groups

  def initialize
    @dependencies = []
    @sources      = ["https://rubygems.org"]
    @ruby_version = nil
    @groups       = {}
    @current_group = nil
  end

  def source(url, &block)
    @sources << url unless @sources.include?(url)
    instance_eval(&block) if block_given?
  end

  def ruby(version, **opts)
    @ruby_version = version
  end

  def gem(name, *reqs, **opts)
    path    = opts.delete(:path)
    git     = opts.delete(:git)
    branch  = opts.delete(:branch)
    groups  = [opts.delete(:group) || opts.delete(:groups) || @current_group].flatten.compact
    require_opt = opts.delete(:require)

    @dependencies << {
      name:    name.to_s,
      reqs:    reqs.map(&:to_s).reject(&:empty?),
      path:    path,
      git:     git,
      branch:  branch,
      groups:  groups.map(&:to_s),
      require: require_opt,
    }
  end

  def group(*names, &block)
    @current_group = names.map(&:to_s)
    instance_eval(&block) if block_given?
    @current_group = nil
  end

  def gemspec(name: nil, path: ".", **opts)
    root = File.expand_path(path)
    specs = Dir.glob(File.join(root, "*.gemspec"))
    specs.each do |s|
      Gem::Specification.reset!
      Gem::Specification._loading_spec = nil
      load s
      spec = Gem::Specification._loading_spec
      next unless spec
      @dependencies << {
        name:   spec.name,
        reqs:   [],
        path:   root,
        groups: [],
        spec:   spec,
        from_gemspec: true,
      }
      (spec.runtime_dependencies || []).each do |dep|
        @dependencies << {
          name:  dep.name,
          reqs:  [dep.requirement.to_s],
          groups: [],
        }
      end
    end
  end

  def self.evaluate(gemfile_path)
    dsl = new
    dsl.instance_eval(File.read(gemfile_path), gemfile_path)
    dsl
  end
end

def normalized_dependencies(dsl)
  ordered = []
  by_name = {}

  dsl.dependencies.each do |dep|
    name = dep[:name]
    existing = by_name[name]
    if existing
      if dep[:path] || dep[:git] || dep[:spec]
        existing[:path] = dep[:path] if dep[:path]
        existing[:git] = dep[:git] if dep[:git]
        existing[:branch] = dep[:branch] if dep[:branch]
        existing[:spec] = dep[:spec] if dep[:spec]
      end
      if existing[:reqs].empty? && dep[:reqs] && !dep[:reqs].empty?
        existing[:reqs] = dep[:reqs]
      end
      existing[:groups] |= dep[:groups] if dep[:groups]
      existing[:require] = dep[:require] if dep.key?(:require) && !dep[:require].nil?
    else
      copy = {
        name: name,
        reqs: (dep[:reqs] || []).dup,
        path: dep[:path],
        git: dep[:git],
        branch: dep[:branch],
        groups: (dep[:groups] || []).dup,
        require: dep[:require],
        spec: dep[:spec],
        from_gemspec: dep[:from_gemspec],
      }
      ordered << copy
      by_name[name] = copy
    end
  end

  ordered
end

def expanded_dependencies(dsl)
  ordered = normalized_dependencies(dsl)
  by_name = {}
  ordered.each { |dep| by_name[dep[:name]] = dep }

  index = 0
  while index < ordered.length
    dep = ordered[index]
    spec = dep[:spec] || bundle_load_path_spec(dep)
    dep[:spec] = spec if spec

    (spec&.runtime_dependencies || []).each do |runtime_dep|
      existing = by_name[runtime_dep.name]
      if existing
        if existing[:reqs].empty?
          existing[:reqs] = [runtime_dep.requirement.to_s]
        end
        next
      end

      injected = {
        name: runtime_dep.name,
        reqs: [runtime_dep.requirement.to_s],
        groups: (dep[:groups] || []).dup,
      }
      ordered << injected
      by_name[injected[:name]] = injected
    end

    index += 1
  end

  ordered
end

def bundle_config_value(key)
  env_key = "BUNDLE_#{key.upcase}"
  env_val = ENV[env_key]
  return env_val if env_val && !env_val.empty?
  cfg = merged_bundle_config()
  cfg[env_key]
end

def bundle_without_groups
  bundle_config_value("WITHOUT").to_s.split(/[:\s,]+/).map(&:strip).reject(&:empty?)
end

def bundle_with_groups
  bundle_config_value("WITH").to_s.split(/[:\s,]+/).map(&:strip).reject(&:empty?)
end

def active_dependencies(dsl)
  excluded = bundle_without_groups
  included = bundle_with_groups
  expanded_dependencies(dsl).reject do |dep|
    groups = dep[:groups] || []
    excluded_hit = groups.any? { |group| excluded.include?(group) }
    included_hit = groups.any? { |group| included.include?(group) }
    excluded_hit && !included_hit
  end
end

# ── Lockfile ─────────────────────────────────────────────────────────────────

class Lockfile
  attr_reader :gems

  def initialize
    @gems = {}
  end

  def self.read(path)
    lf = new
    return lf unless File.exist?(path)
    File.readlines(path).each do |line|
      if line =~ /^\s{4}(\S+)\s+\(([^)]+)\)/
        lf.gems[$1] = $2
      end
    end
    lf
  end

  def self.write(path, resolved)
    lines = ["GEM", "  specs:"]
    resolved.sort_by { |k, _| k }.each do |name, ver|
      lines << "    #{name} (#{ver})"
    end
    lines << ""
    lines << "BUNDLED WITH"
    lines << "   #{BUNDLE_VERSION}"
    lines << ""
    File.write(path, lines.join("\n"))
  end
end

def lockfile_resolved_dependencies(dsl, resolved)
  locked = resolved.dup

  expanded_dependencies(dsl).each do |dep|
    next if locked.key?(dep[:name])
    if dep[:path] && !dep[:from_gemspec]
      locked[dep[:name]] = "path"
      next
    end
    if dep[:spec] && dep[:spec].respond_to?(:version)
      locked[dep[:name]] = dep[:spec].version.to_s
    end
  end

  locked
end

def bundle_load_path_spec(dep)
  return dep[:spec] if dep[:spec]
  return nil unless dep[:path]
  specs = Dir.glob(File.join(File.expand_path(dep[:path]), "*.gemspec"))
  specs.each do |path|
    Gem::Specification.reset!
    Gem::Specification._loading_spec = nil
    load path
    spec = Gem::Specification._loading_spec
    return spec if spec
  end
  nil
end

def bundle_dep_display_version(dep, lockfile)
  return "path" if dep[:path] && !dep[:from_gemspec]
  locked = lockfile.gems[dep[:name]]
  return locked if locked
  return dep[:spec].version.to_s if dep[:spec] && dep[:spec].respond_to?(:version)
  spec = Gem::Specification.find_by_name(dep[:name])
  return spec.version.to_s if spec
  dep[:path] ? "path" : "not installed"
end

def bundle_find_active_dependency(dsl, gem_name)
  active_dependencies(dsl).find { |dep| dep[:name] == gem_name }
end

def bundle_dep_path(dep, lockfile)
  if dep[:path]
    return File.expand_path(dep[:path])
  end

  locked = lockfile.gems[dep[:name]]
  Gem::Specification.reset!
  spec = Gem::Specification.find_by_name(dep[:name])
  return nil unless spec
  return nil if locked && spec.version.to_s != locked

  spec.gem_dir
end

def bundle_exec_path_for(dep, command)
  if dep[:path]
    spec = bundle_load_path_spec(dep)
    return nil unless spec
    executables = spec.executables || []
    return nil unless executables.include?(command)
    bindir = spec.bindir || "bin"
    candidate = File.join(File.expand_path(dep[:path]), bindir, command)
    return candidate if File.exist?(candidate)
    return nil
  end

  spec = Gem::Specification.find_by_name(dep[:name])
  return nil unless spec
  executables = spec.executables || []
  return nil unless executables.include?(command)
  begin
    candidate = Gem.bin_path(dep[:name], command, spec.version.to_s)
    return candidate if candidate && File.exist?(candidate)
  rescue StandardError
  end
  bindir = spec.bindir || "bin"
  candidate = File.join(spec.gem_dir, bindir, command)
  return candidate if File.exist?(candidate)
  nil
end

def bundle_exec_target(dsl, lockfile, command)
  return File.expand_path(command) if command.end_with?(".rb") && File.exist?(command)

  active_dependencies(dsl).each do |dep|
    candidate = bundle_exec_path_for(dep, command)
    return candidate if candidate
  end

  nil
end

def bundle_missing_dependencies(dsl, lockfile)
  active_dependencies(dsl).reject do |dep|
    locked = lockfile.gems[dep[:name]]
    if dep[:path]
      path_ok = File.directory?(File.expand_path(dep[:path]))
      path_ok && !locked.nil?
    else
      spec = Gem::Specification.find_by_name(dep[:name])
      spec && (!locked || spec.version.to_s == locked)
    end
  end
end

def bundle_needs_remote_tools?(dsl)
  active_dependencies(dsl).any? { |dep| !dep[:path] && !dep[:git] }
end

# ── Resolution ───────────────────────────────────────────────────────────────

def check_tool(name)
  ENV["PATH"].to_s.split(":").any? do |dir|
    path = File.join(dir, name)
    File.file?(path) && File.executable?(path)
  end
end

def fetch_url(url)
  out = `curl -fsSL #{url} 2>/dev/null`
  out.empty? ? nil : out
end

def fetch_version(gem_name, requirements, force_remote: false)
  reqs = (requirements || []).reject { |r| r.to_s.strip.empty? || r.to_s.strip == ">= 0" }

  unless force_remote
    Gem::Specification.reset!
    local = Gem::Specification.find_by_name(gem_name)
    if local
      if reqs.empty?
        return local.version.to_s
      else
        req = Gem::Requirement.new(reqs)
        return local.version.to_s if req.satisfied_by?(Gem::Version.new(local.version.to_s))
      end
    end
  end

  if reqs.any?
    # Try the versions endpoint to find the best satisfying version
    body = fetch_url("#{GEM_SERVER}/api/v1/versions/#{gem_name}.json")
    if body
      versions = body.scan(/"number"\s*:\s*"([^"]+)"/).flatten
      req = Gem::Requirement.new(reqs)
      matching = versions.select do |v|
        begin
          req.satisfied_by?(Gem::Version.new(v))
        rescue StandardError
          false
        end
      end
      if matching.any?
        best = matching.sort_by { |v| v.split(".").map(&:to_i) }.last
        return best
      end
    end
  end

  # Fall back to latest via gems API
  body = fetch_url("#{GEM_SERVER}/api/v1/gems/#{gem_name}.json")
  return nil unless body
  body =~ /"version"\s*:\s*"([^"]+)"/ ? $1 : nil
end

# Build a loadable gemspec string from a loaded Gem::Specification object.
def spec_to_gemspec_str(spec, install_dir = nil)
  lines = ["Gem::Specification.new do |s|"]
  lines << "  s.name    = #{spec.name.inspect}"
  lines << "  s.version = Gem::Version.new(#{spec.version.to_s.inspect})"
  lines << "  s.summary = #{spec.summary.to_s.inspect}"
  rp = spec.require_paths || ["lib"]
  lines << "  s.require_paths = #{rp.inspect}"
  (spec.runtime_dependencies || []).each do |dep|
    lines << "  s.add_runtime_dependency #{dep.name.inspect}, #{dep.requirement.to_s.inspect}"
  end
  exes = spec.executables || []
  if exes.empty? && install_dir
    bd  = File.join(install_dir, spec.bindir || "bin")
    exes = Dir.children(bd) if File.directory?(bd)
  end
  lines << "  s.executables = #{exes.inspect}" unless exes.empty?
  bd = spec.bindir
  lines << "  s.bindir = #{bd.inspect}" if bd && bd != "bin"
  lines << "end"
  lines.join("\n") + "\n"
end

# Parse a metadata.gz file from a .gem archive into a plain Hash.
def parse_gem_metadata(metadata_gz_path)
  return nil unless File.exist?(metadata_gz_path)
  text = `gzip -dc #{metadata_gz_path.inspect} 2>/dev/null`
  return nil if text.empty?

  result = {}
  result[:name]    = $1.strip if text =~ /^name:\s*(.+)$/
  if text =~ /^version:.*\n\s+version:\s*'([^']+)'/
    result[:version] = $1
  elsif text =~ /^version:.*\n\s+version:\s*"([^"]+)"/
    result[:version] = $1
  elsif text =~ /^version:.*\n\s+version:\s*(\S+)/
    result[:version] = $1
  end
  result[:bindir] = $1.strip if text =~ /^bindir:\s*(.+)$/
  if text =~ /^require_paths:\n((?:- \S[^\n]*\n)+)/
    result[:require_paths] = $1.scan(/^- (\S[^\n]*)$/).flatten.map(&:strip)
  else
    result[:require_paths] = ["lib"]
  end
  if text =~ /^executables:\n((?:- \S[^\n]*\n)+)/
    result[:executables] = $1.scan(/^- (\S[^\n]*)$/).flatten.map(&:strip)
  else
    result[:executables] = []
  end

  # Walk dependencies line-by-line (handles both rubygems.org and our own format)
  runtime_deps = []
  dep_name = nil
  dep_type = nil
  text.each_line do |line|
    if line =~ /!ruby\/object:Gem::Dependency/
      if dep_name && dep_type == ":runtime"
        runtime_deps << dep_name
      end
      dep_name = nil
      dep_type = nil
    elsif dep_name.nil? && line =~ /^\s+name:\s*(.+)$/
      dep_name = $1.strip
    elsif line =~ /^\s+type:\s*(.+)$/
      dep_type = $1.strip
    end
  end
  if dep_name && dep_type == ":runtime"
    runtime_deps << dep_name
  end
  result[:runtime_deps] = runtime_deps
  result
end

# Build a loadable gemspec string from parsed metadata hash.
def meta_to_gemspec_str(meta, gem_name, version, install_dir = nil)
  name    = meta[:name] || gem_name
  bindir  = meta[:bindir] || "bin"
  rp      = meta[:require_paths] || ["lib"]
  exes    = meta[:executables] || []
  if exes.empty? && install_dir
    bd   = File.join(install_dir, bindir)
    exes = Dir.children(bd) if File.directory?(bd)
  end
  lines = ["Gem::Specification.new do |s|"]
  lines << "  s.name    = #{name.inspect}"
  lines << "  s.version = Gem::Version.new(#{version.inspect})"
  lines << "  s.require_paths = #{rp.inspect}"
  (meta[:runtime_deps] || []).each do |dep_name|
    lines << "  s.add_runtime_dependency #{dep_name.inspect}, \">= 0\""
  end
  lines << "  s.executables = #{exes.inspect}" unless exes.empty?
  lines << "  s.bindir = #{bindir.inspect}" if bindir != "bin"
  lines << "end"
  lines.join("\n") + "\n"
end

def install_gem_from_server(gem_name, version)
  gem_full  = "#{gem_name}-#{version}"
  url       = "#{GEM_SERVER}/gems/#{gem_full}.gem"
  home      = Gem.home
  gems_dir  = File.join(home, "gems")
  specs_dir = File.join(home, "specifications")
  bin_dir   = File.join(home, "bin")
  [home, gems_dir, specs_dir, bin_dir].each { |d| system("mkdir", "-p", d) unless File.directory?(d) }

  tmp = "/tmp/stoned_bundle_install_#{gem_name}_#{$$}"
  system("mkdir", "-p", tmp)
  begin
    gem_path = File.join(tmp, "#{gem_full}.gem")
    return false unless system("curl", "-fsSL", "-o", gem_path, url)
    return false unless system("tar", "-xf", gem_path, "-C", tmp)
    install_dir = File.join(gems_dir, gem_full)
    system("mkdir", "-p", install_dir)
    data_tar = File.join(tmp, "data.tar.gz")
    return false unless File.exist?(data_tar)
    return false unless system("tar", "-xzf", data_tar, "-C", install_dir)

    spec_path = File.join(specs_dir, "#{gem_full}.gemspec")
    unless File.exist?(spec_path)
      wrapper_bindir = "bin"
      gemspec_src = File.join(install_dir, "#{gem_name}.gemspec")
      if File.exist?(gemspec_src)
        Gem::Specification.reset!
        Gem::Specification._loading_spec = nil
        load gemspec_src
        real_spec = Gem::Specification._loading_spec
        if real_spec && !real_spec.name.to_s.empty?
          wrapper_bindir = real_spec.bindir || "bin"
          File.write(spec_path, spec_to_gemspec_str(real_spec, install_dir))
        end
      end
      unless File.exist?(spec_path)
        meta = parse_gem_metadata(File.join(tmp, "metadata.gz"))
        if meta && meta[:name]
          wrapper_bindir = meta[:bindir] || "bin"
          File.write(spec_path, meta_to_gemspec_str(meta, gem_name, version, install_dir))
        else
          File.write(spec_path, "Gem::Specification.new do |s|\n  s.name = #{gem_name.inspect}\n  s.version = Gem::Version.new(#{version.inspect})\n  s.require_paths = [\"lib\"]\nend\n")
        end
      end
    else
      wrapper_bindir = "bin"
    end

    bin_src = File.join(install_dir, wrapper_bindir)
    if File.directory?(bin_src)
      Dir.children(bin_src).each do |exe|
        wrapper  = File.join(bin_dir, exe)
        exe_path = File.join(bin_src, exe)
        File.write(wrapper, "#!/usr/bin/env ruby\nload #{exe_path.inspect}\n")
        system("chmod", "+x", wrapper)
      end
    end
    Gem::Specification.reset!
    true
  ensure
    system("rm", "-rf", tmp)
  end
end

def resolve_and_install(dsl, verbose: true, force_update: false)
  resolved = {}
  errors   = []
  # Seed queue from Gemfile deps; track names to avoid duplicates
  queue   = active_dependencies(dsl).dup
  queued  = {}
  queue.each { |d| queued[d[:name]] = true }

  until queue.empty?
    dep  = queue.shift
    name = dep[:name]
    next if resolved.key?(name)

    if dep[:path]
      lib = File.join(File.expand_path(dep[:path]), "lib")
      $LOAD_PATH.unshift(lib) unless $LOAD_PATH.include?(lib)
      spec = bundle_load_path_spec(dep)
      dep[:spec] = spec if spec
      resolved[name] = if dep[:from_gemspec] && spec&.respond_to?(:version)
        spec.version.to_s
      else
        "path"
      end
      puts "Using #{name} (path: #{dep[:path]})" if verbose
      enqueue_runtime_deps(spec, dep[:groups], queue, queued, resolved)
      next
    end

    if dep[:git]
      puts "WARNING: git sources not yet supported — skipping #{name}" if verbose
      next
    end

    Gem::Specification.reset!
    candidate = force_update ? nil : Gem::Specification.find_by_name(name)
    # Verify locally installed version satisfies Gemfile requirements
    if candidate
      relevant = (dep[:reqs] || []).reject { |r| r.to_s.strip.empty? || r.to_s.strip == ">= 0" }
      if relevant.any?
        req = Gem::Requirement.new(relevant)
        candidate = nil unless req.satisfied_by?(Gem::Version.new(candidate.version.to_s))
      end
    end
    spec = candidate
    if spec
      resolved[name] = spec.version.to_s
      puts "Using #{name} #{spec.version}" if verbose
      enqueue_runtime_deps(spec, dep[:groups], queue, queued, resolved)
    else
      version = fetch_version(name, dep[:reqs], force_remote: force_update)
      unless version
        errors << "Could not find gem '#{name}'"
        next
      end
      puts "Fetching #{name} #{version}..." if verbose
      if install_gem_from_server(name, version)
        resolved[name] = version
        puts "Installed #{name} #{version}" if verbose
        Gem::Specification.reset!
        installed = Gem::Specification.find_by_name(name)
        enqueue_runtime_deps(installed, dep[:groups], queue, queued, resolved)
      else
        errors << "Failed to install #{name} #{version}"
      end
    end
  end

  errors.each { |e| STDERR.puts "ERROR: #{e}" }
  errors.empty? ? resolved : nil
end

def enqueue_runtime_deps(spec, groups, queue, queued, resolved)
  return unless spec
  (spec.runtime_dependencies || []).each do |rdep|
    next if resolved.key?(rdep.name) || queued.key?(rdep.name)
    queued[rdep.name] = true
    queue << { name: rdep.name, reqs: [rdep.requirement.to_s], groups: (groups || []).dup }
  end
end

def setup_load_path(dsl, lockfile)
  active_dependencies(dsl).each do |dep|
    name = dep[:name]
    if dep[:path]
      lib = File.join(File.expand_path(dep[:path]), "lib")
      $LOAD_PATH.unshift(lib) unless $LOAD_PATH.include?(lib)
      next
    end
    version = lockfile.gems[name]
    next unless version
    gem_dir = File.join(Gem.home, "gems", "#{name}-#{version}", "lib")
    $LOAD_PATH.unshift(gem_dir) unless $LOAD_PATH.include?(gem_dir) || !File.directory?(gem_dir)
  end
end

# ── Bundle config helpers ─────────────────────────────────────────────────────

def bundle_local_config_path
  File.join(".bundle", "config")
end

def bundle_global_config_path
  File.join(ENV["HOME"] || "/", ".bundle", "config")
end

def read_bundle_config(path)
  return {} unless File.exist?(path)
  config = {}
  File.readlines(path).each do |line|
    line = line.chomp
    next if line == "---" || line.strip.empty?
    if line =~ /^(BUNDLE_\w+):\s*"([^"]*)"\s*$/
      config[$1] = $2
    elsif line =~ /^(BUNDLE_\w+):\s*(\S+)\s*$/
      config[$1] = $2
    end
  end
  config
end

def write_bundle_config(path, config)
  dir = File.dirname(path)
  Dir.mkdir(dir) unless File.directory?(dir)
  lines = ["---"]
  config.each { |k, v| lines << "#{k}: \"#{v}\"" }
  File.write(path, lines.join("\n") + "\n")
end

def merged_bundle_config
  global = read_bundle_config(bundle_global_config_path())
  local  = read_bundle_config(bundle_local_config_path())
  global.merge(local)
end

def config_env_key(key)
  key.upcase.start_with?("BUNDLE_") ? key.upcase : "BUNDLE_#{key.upcase}"
end

def resolve_no_install(dsl)
  resolved = {}
  active_dependencies(dsl).each do |dep|
    next if resolved.key?(dep[:name])
    if dep[:path]
      spec = bundle_load_path_spec(dep)
      resolved[dep[:name]] = spec && spec.respond_to?(:version) ? spec.version.to_s : "path"
    elsif dep[:git]
      resolved[dep[:name]] = "git"
    else
      Gem::Specification.reset!
      spec = Gem::Specification.find_by_name(dep[:name])
      resolved[dep[:name]] = spec ? spec.version.to_s : nil
    end
  end
  resolved.reject { |_, v| v.nil? }
end

# ── Commands ─────────────────────────────────────────────────────────────────

command = ARGV[0]
args    = ARGV[1..]

case command
when "version", "-v", "--version"
  puts "Bundler version #{BUNDLE_VERSION}"

when "install", "i"
  frozen = args.include?("--frozen") || args.include?("--deployment")

  # Persist --without / --with to .bundle/config
  without_idx  = args.index("--without")
  with_idx     = args.index("--with")
  without_flag = without_idx ? args[without_idx + 1] : nil
  with_flag    = with_idx    ? args[with_idx + 1]    : nil
  if without_flag
    cfg_path = bundle_local_config_path()
    cfg = read_bundle_config(cfg_path)
    cfg["BUNDLE_WITHOUT"] = without_flag
    write_bundle_config(cfg_path, cfg)
  end
  if with_flag
    cfg_path = bundle_local_config_path()
    cfg = read_bundle_config(cfg_path)
    cfg["BUNDLE_WITH"] = with_flag
    write_bundle_config(cfg_path, cfg)
  end

  unless File.exist?(GEMFILE)
    STDERR.puts "Could not locate Gemfile"
    exit 1
  end
  if frozen && !File.exist?(LOCKFILE)
    STDERR.puts "Your lockfile needs to be updated, but the `--frozen` flag was passed."
    exit 1
  end
  dsl = GemfileDSL.evaluate(GEMFILE)
  if bundle_needs_remote_tools?(dsl) && !(check_tool("curl") && check_tool("tar"))
    STDERR.puts "curl and tar are required for bundle install"
    exit 1
  end
  if frozen
    resolved = resolve_and_install(dsl, verbose: false)
    if resolved
      new_lock = lockfile_resolved_dependencies(dsl, resolved)
      existing = Lockfile.read(LOCKFILE)
      drift = new_lock.keys.any? { |k| existing.gems[k] != new_lock[k] } ||
              existing.gems.keys.any? { |k| !new_lock.key?(k) }
      if drift
        STDERR.puts "Your lockfile needs to be updated, but the `--frozen` flag was passed."
        exit 1
      end
      puts "Bundle complete! #{resolved.length} gems now installed."
    else
      STDERR.puts "Bundle install failed."
      exit 1
    end
  else
    resolved = resolve_and_install(dsl, verbose: true)
    if resolved
      Lockfile.write(LOCKFILE, lockfile_resolved_dependencies(dsl, resolved))
      puts "Bundle complete! #{resolved.length} gems now installed."
    else
      STDERR.puts "Bundle install failed."
      exit 1
    end
  end

when "exec"
  if args.empty?
    STDERR.puts "Usage: bundle exec <command>"
    exit 1
  end
  unless File.exist?(GEMFILE)
    STDERR.puts "Could not locate Gemfile"
    exit 1
  end
  dsl = GemfileDSL.evaluate(GEMFILE)
  unless File.exist?(LOCKFILE)
    STDERR.puts "Could not locate Gemfile.lock"
    exit 1
  end
  lf  = Lockfile.read(LOCKFILE)
  missing = bundle_missing_dependencies(dsl, lf)
  unless missing.empty?
    STDERR.puts "The following gems are missing:"
    missing.each { |d| STDERR.puts "  * #{d[:name]}" }
    exit 1
  end
  setup_load_path(dsl, lf)
  while !ARGV.empty?
    ARGV.pop
  end
  (args[1..] || []).each do |arg|
    ARGV << arg
  end
  target = bundle_exec_target(dsl, lf, args[0])
  unless target
    STDERR.puts "Command not found: #{args[0]}"
    exit 1
  end
  load target

when "check"
  unless File.exist?(GEMFILE)
    STDERR.puts "Could not locate Gemfile"
    exit 1
  end
  dsl = GemfileDSL.evaluate(GEMFILE)
  unless File.exist?(LOCKFILE)
    STDERR.puts "Could not locate Gemfile.lock"
    exit 1
  end
  lf = Lockfile.read(LOCKFILE)
  missing = bundle_missing_dependencies(dsl, lf)
  if missing.empty?
    puts "The Gemfile's dependencies are satisfied"
  else
    STDERR.puts "The following gems are missing:"
    missing.each { |d| STDERR.puts "  * #{d[:name]}" }
    exit 1
  end

when "list"
  unless File.exist?(GEMFILE)
    STDERR.puts "Could not locate Gemfile"
    exit 1
  end
  dsl = GemfileDSL.evaluate(GEMFILE)
  unless File.exist?(LOCKFILE)
    STDERR.puts "Could not locate Gemfile.lock"
    exit 1
  end
  lf = Lockfile.read(LOCKFILE)
  Gem::Specification.reset!
  puts "Gems included by the bundle:"
  active_dependencies(dsl).each do |dep|
    puts "  * #{dep[:name]} (#{bundle_dep_display_version(dep, lf)})"
  end

when "show", "info", "open"
  unless File.exist?(GEMFILE)
    STDERR.puts "Could not locate Gemfile"
    exit 1
  end
  dsl = GemfileDSL.evaluate(GEMFILE)
  unless File.exist?(LOCKFILE)
    STDERR.puts "Could not locate Gemfile.lock"
    exit 1
  end
  lf = Lockfile.read(LOCKFILE)
  missing = bundle_missing_dependencies(dsl, lf)
  unless missing.empty?
    STDERR.puts "The following gems are missing:"
    missing.each { |d| STDERR.puts "  * #{d[:name]}" }
    exit 1
  end

  if (command == "open" || command == "info") && args.empty?
    STDERR.puts "Usage: bundle #{command} GEM"
    exit 1
  end

  if args.empty?
    active_dependencies(dsl).each do |dep|
      path = bundle_dep_path(dep, lf)
      next unless path
      puts "#{dep[:name]} => #{path}"
    end
  else
    dep = bundle_find_active_dependency(dsl, args[0])
    unless dep
      STDERR.puts "Could not find gem '#{args[0]}' in the current bundle"
      exit 1
    end
    path = bundle_dep_path(dep, lf)
    unless path
      STDERR.puts "Could not resolve gem '#{args[0]}'"
      exit 1
    end
    puts path
  end

when "config"
  subcommand = args[0]
  case subcommand
  when nil, "list"
    merged = merged_bundle_config()
    if merged.empty?
      puts "You have no settings"
    else
      merged.each { |k, v| puts "#{k}: \"#{v}\"" }
    end

  when "get"
    key = args[1]
    unless key
      STDERR.puts "Usage: bundle config get KEY"
      exit 1
    end
    env_key = config_env_key(key)
    merged  = merged_bundle_config()
    value   = merged[env_key] || ENV[env_key]
    if value
      puts "#{env_key}: \"#{value}\""
    else
      puts "#{env_key} is not set"
    end

  when "set"
    is_global = args.include?("--global")
    cleaned   = args.reject { |a| a.start_with?("--") }
    key   = cleaned[1]
    value = cleaned[2]
    unless key && value
      STDERR.puts "Usage: bundle config set [--local|--global] KEY VALUE"
      exit 1
    end
    env_key  = config_env_key(key)
    cfg_path = is_global ? bundle_global_config_path() : bundle_local_config_path()
    cfg = read_bundle_config(cfg_path)
    cfg[env_key] = value
    write_bundle_config(cfg_path, cfg)
    scope = is_global ? "the current user (#{cfg_path})" : "your local app (#{cfg_path})"
    puts "Set for #{scope}: #{env_key}=#{value}"

  when "unset"
    is_global = args.include?("--global")
    cleaned   = args.reject { |a| a.start_with?("--") }
    key = cleaned[1]
    unless key
      STDERR.puts "Usage: bundle config unset [--global] KEY"
      exit 1
    end
    env_key  = config_env_key(key)
    cfg_path = is_global ? bundle_global_config_path() : bundle_local_config_path()
    cfg = read_bundle_config(cfg_path)
    if cfg.key?(env_key)
      cfg.delete(env_key)
      write_bundle_config(cfg_path, cfg)
      scope = is_global ? "the current user (#{cfg_path})" : "your local app (#{cfg_path})"
      puts "Unset for #{scope}"
    else
      puts "#{env_key} is not set for #{is_global ? "the current user" : "your local app"}"
    end

  else
    # Legacy form: bundle config KEY [VALUE]
    env_key  = config_env_key(subcommand)
    cfg_path = bundle_local_config_path()
    if args.length >= 2
      value = args[1]
      cfg   = read_bundle_config(cfg_path)
      cfg[env_key] = value
      write_bundle_config(cfg_path, cfg)
      puts "Set for your local app (#{cfg_path}): #{env_key}=#{value}"
    else
      merged = merged_bundle_config()
      value  = merged[env_key] || ENV[env_key]
      if value
        puts "#{env_key}: \"#{value}\""
      else
        puts "#{env_key} is not set"
      end
    end
  end

when "lock"
  unless File.exist?(GEMFILE)
    STDERR.puts "Could not locate Gemfile"
    exit 1
  end
  dsl = GemfileDSL.evaluate(GEMFILE)
  resolved = resolve_no_install(dsl)
  Lockfile.write(LOCKFILE, lockfile_resolved_dependencies(dsl, resolved))
  puts "Writing lockfile to #{File.expand_path(LOCKFILE)}"

when "env"
  puts "## Bundler"
  puts ""
  puts "Bundler version #{BUNDLE_VERSION}"
  merged = merged_bundle_config()
  unless merged.empty?
    puts ""
    puts "## Configuration"
    puts ""
    merged.sort.each { |k, v| puts "#{k}: \"#{v}\"" }
  end
  if File.exist?(GEMFILE)
    puts ""
    puts "## Gemfile"
    puts ""
    puts "Gemfile: #{File.expand_path(GEMFILE)}"
  end

when "binstubs"
  if args.empty?
    STDERR.puts "Usage: bundle binstubs GEM [GEM2 ...]"
    exit 1
  end
  unless File.exist?(GEMFILE)
    STDERR.puts "Could not locate Gemfile"
    exit 1
  end
  dsl = GemfileDSL.evaluate(GEMFILE)
  unless File.exist?(LOCKFILE)
    STDERR.puts "Could not locate Gemfile.lock"
    exit 1
  end
  lf = Lockfile.read(LOCKFILE)

  bin_dir = "bin"
  Dir.mkdir(bin_dir) unless File.directory?(bin_dir)

  gem_names = args.reject { |a| a.start_with?("--") }
  gem_names.each do |gem_name|
    dep = bundle_find_active_dependency(dsl, gem_name)
    unless dep
      STDERR.puts "Could not find gem '#{gem_name}' in the current bundle"
      next
    end

    if dep[:path]
      spec      = bundle_load_path_spec(dep)
      exes      = spec ? (spec.executables || []) : []
      bin_base  = File.join(File.expand_path(dep[:path]), spec ? (spec.bindir || "bin") : "bin")
    else
      Gem::Specification.reset!
      spec     = Gem::Specification.find_by_name(gem_name)
      exes     = spec ? (spec.executables || []) : []
      bin_base = spec ? File.join(spec.gem_dir, spec.bindir || "bin") : nil
    end

    if exes.empty?
      puts "#{gem_name} has no executables"
      next
    end

    exes.each do |exe|
      exe_path  = bin_base ? File.join(bin_base, exe) : exe
      stub_path = File.join(bin_dir, exe)
      File.write(stub_path, "#!/usr/bin/env ruby\n# Binstub generated by stoned bundler\nload #{exe_path.inspect}\n")
      system("chmod", "+x", stub_path)
      puts "Wrote binstub for #{exe} to #{stub_path}"
    end
  end

when "update"
  unless File.exist?(GEMFILE)
    STDERR.puts "Could not locate Gemfile"
    exit 1
  end
  dsl = GemfileDSL.evaluate(GEMFILE)
  if bundle_needs_remote_tools?(dsl) && !(check_tool("curl") && check_tool("tar"))
    STDERR.puts "curl and tar are required for bundle update"
    exit 1
  end
  # Re-resolve fresh: delete lockfile so fetch_version skips local cache
  File.delete(LOCKFILE) if File.exist?(LOCKFILE)
  resolved = resolve_and_install(dsl, verbose: true, force_update: true)
  if resolved
    Lockfile.write(LOCKFILE, lockfile_resolved_dependencies(dsl, resolved))
    puts "Bundle updated!"
  else
    STDERR.puts "Bundle update failed."
    exit 1
  end

when "outdated"
  unless File.exist?(GEMFILE)
    STDERR.puts "Could not locate Gemfile"
    exit 1
  end
  unless File.exist?(LOCKFILE)
    STDERR.puts "Could not locate Gemfile.lock"
    exit 1
  end
  dsl = GemfileDSL.evaluate(GEMFILE)
  lf  = Lockfile.read(LOCKFILE)

  outdated = []
  active_dependencies(dsl).each do |dep|
    next if dep[:path] || dep[:git]
    locked = lf.gems[dep[:name]]
    next unless locked

    body = fetch_url("#{GEM_SERVER}/api/v1/gems/#{dep[:name]}.json")
    next unless body
    next unless body =~ /"version"\s*:\s*"([^"]+)"/
    latest = $1

    if latest != locked
      outdated << { name: dep[:name], current: locked, latest: latest }
    end
  end

  if outdated.empty?
    puts "Bundle up to date!"
  else
    puts "Outdated gems included in the bundle:"
    outdated.each do |info|
      puts "  * #{info[:name]} (newest #{info[:latest]}, installed #{info[:current]})"
    end
  end

when "add"
  positional = args.reject { |a| a.start_with?("-") }
  gem_name   = positional.first
  unless gem_name
    STDERR.puts "Usage: bundle add GEM [--version VERSION] [--group GROUP] [--path PATH]"
    exit 1
  end
  unless File.exist?(GEMFILE)
    STDERR.puts "Could not locate Gemfile"
    exit 1
  end

  ver_idx   = args.index("--version") || args.index("-v")
  ver_opt   = ver_idx ? args[ver_idx + 1] : nil
  grp_idx   = args.index("--group") || args.index("-g")
  grp_opt   = grp_idx ? args[grp_idx + 1] : nil
  path_idx  = args.index("--path")
  path_opt  = path_idx ? args[path_idx + 1] : nil

  content = File.read(GEMFILE)
  already = content.lines.any? do |line|
    stripped = line.strip
    !stripped.start_with?("#") &&
      (stripped.include?("gem #{gem_name.inspect}") || stripped.include?("gem '#{gem_name}'"))
  end
  if already
    STDERR.puts "#{gem_name} is already in your Gemfile"
    exit 1
  end

  gem_parts = ["gem #{gem_name.inspect}"]
  gem_parts << ", #{ver_opt.inspect}" if ver_opt
  gem_parts << ", path: #{path_opt.inspect}" if path_opt
  gem_parts << ", group: :#{grp_opt}" if grp_opt
  File.write(GEMFILE, content.chomp + "\n#{gem_parts.join}\n")
  puts "#{gem_name} added to Gemfile"

  dsl = GemfileDSL.evaluate(GEMFILE)
  if bundle_needs_remote_tools?(dsl) && !(check_tool("curl") && check_tool("tar"))
    STDERR.puts "curl and tar are required for bundle install"
    exit 1
  end
  resolved = resolve_and_install(dsl, verbose: true)
  if resolved
    Lockfile.write(LOCKFILE, lockfile_resolved_dependencies(dsl, resolved))
    puts "Bundle complete! #{resolved.length} gems now installed."
  else
    STDERR.puts "Bundle install failed."
    exit 1
  end

when "remove"
  positional = args.reject { |a| a.start_with?("-") }
  gem_name   = positional.first
  unless gem_name
    STDERR.puts "Usage: bundle remove GEM"
    exit 1
  end
  unless File.exist?(GEMFILE)
    STDERR.puts "Could not locate Gemfile"
    exit 1
  end

  content = File.read(GEMFILE)
  new_content = content.lines.reject { |line|
    stripped = line.strip
    !stripped.start_with?("#") &&
      (stripped.include?("gem #{gem_name.inspect}") || stripped.include?("gem '#{gem_name}'"))
  }.join

  if new_content == content
    STDERR.puts "#{gem_name} is not in your Gemfile"
    exit 1
  end

  File.write(GEMFILE, new_content)
  puts "#{gem_name} was removed from your Gemfile"

  if File.exist?(LOCKFILE)
    dsl = GemfileDSL.evaluate(GEMFILE)
    resolved = resolve_and_install(dsl, verbose: false)
    if resolved
      Lockfile.write(LOCKFILE, lockfile_resolved_dependencies(dsl, resolved))
    end
  end

when "platform"
  puts "Your platform is: #{RUBY_PLATFORM}"
  puts "Your Ruby is:     #{RUBY_VERSION} (#{RUBY_PLATFORM})"
  puts "Your Bundler is:  #{BUNDLE_VERSION}"
  if File.exist?(GEMFILE)
    merged = merged_bundle_config()
    without = merged["BUNDLE_WITHOUT"] || ENV["BUNDLE_WITHOUT"]
    puts "BUNDLE_WITHOUT:   #{without}" if without && !without.empty?
    with_cfg = merged["BUNDLE_WITH"] || ENV["BUNDLE_WITH"]
    puts "BUNDLE_WITH:      #{with_cfg}" if with_cfg && !with_cfg.empty?
  end

when "console"
  STDERR.puts "bundle #{command}: not yet implemented"
  exit 1

when nil, "help", "--help", "-h"
  puts "Usage: bundle COMMAND"
  puts ""
  puts "Commands:"
  puts "  install       Install gems from Gemfile"
  puts "  exec FILE     Run a Ruby file with bundled gems on the load path"
  puts "  check         Verify Gemfile dependencies are satisfied"
  puts "  list          List gems included in the bundle"
  puts "  show [GEM]    Print bundle gem paths"
  puts "  info GEM      Print the installed path for a bundle gem"
  puts "  open GEM      Print the path for a bundle gem"
  puts "  config        Get/set bundler configuration"
  puts "  lock          Write the lockfile without installing"
  puts "  env           Print environment information"
  puts "  binstubs GEM  Generate binstubs for a gem's executables"
  puts "  update        Re-resolve and update all gems"
  puts "  add GEM       Add a gem to the Gemfile and install"
  puts "  remove GEM    Remove a gem from the Gemfile"
  puts "  outdated      List gems with newer versions available"
  puts "  version       Print Bundler version"
else
  STDERR.puts "Unknown command: #{command}"
  exit 1
end
