#!/usr/bin/env ruby
# gem - stoned RubyGems command-line interface

require "rubygems"
require "open3"

GEM_SERVER = ENV["STONED_GEM_SERVER"] || "https://rubygems.org"

def run_cmd(*args)
  system(*args)
end

def check_tool(name)
  ENV["PATH"].to_s.split(":").any? do |dir|
    path = File.join(dir, name)
    File.file?(path) && File.executable?(path)
  end
end

def fetch_url(url)
  out = `curl -fsSL #{url} 2>/dev/null`
  out.empty? ? nil : out
end

def print_gem_env
  puts "RubyGems Environment:"
  puts "  - RUBYGEMS VERSION: #{Gem::VERSION}"
  puts "  - RUBY VERSION: #{RUBY_VERSION} (#{RUBY_PLATFORM})"
  puts "  - INSTALLATION DIRECTORY: #{Gem.home}"
  puts "  - RUBY EXECUTABLE: #{RbConfig.ruby}"
  puts "  - GEM PATHS:"
  Gem.path.each { |p| puts "     - #{p}" }
  puts "  - REMOTE SOURCES:"
  puts "     - #{GEM_SERVER}"
end

def wrapper_script_for(exe_path)
  "#!/usr/bin/env ruby\nload #{exe_path.inspect}\n"
end

def install_gem_file(gem_path)
  unless check_tool("tar")
    STDERR.puts "ERROR: 'tar' is required for gem install"
    exit 1
  end

  home = Gem.home
  gems_dir = File.join(home, "gems")
  specs_dir = File.join(home, "specifications")
  bin_dir = File.join(home, "bin")
  [home, gems_dir, specs_dir, bin_dir].each do |d|
    system("mkdir", "-p", d) unless File.directory?(d)
  end

  gem_base = File.basename(gem_path, ".gem")
  parts = gem_base.split("-")
  version = parts.pop
  gem_name = parts.join("-")
  gem_full = gem_base

  tmp = "/tmp/stoned_gem_install_#{gem_name}_#{$$}"
  system("mkdir", "-p", tmp)

  begin
    unless system("tar", "-xf", gem_path, "-C", tmp)
      STDERR.puts "ERROR: Failed to extract #{gem_path}"
      return
    end

    install_dir = File.join(gems_dir, gem_full)
    system("mkdir", "-p", install_dir)
    data_tar = File.join(tmp, "data.tar.gz")
    unless File.exist?(data_tar)
      STDERR.puts "ERROR: data.tar.gz not found in gem package"
      return
    end
    unless system("tar", "-xzf", data_tar, "-C", install_dir)
      STDERR.puts "ERROR: Failed to extract gem contents"
      return
    end

    # Try to load the gemspec from the gem for a real spec, fall back to stub
    spec_path = File.join(specs_dir, "#{gem_full}.gemspec")
    unless File.exist?(spec_path)
      wrapper_bindir = "bin"
      gemspec_src = File.join(install_dir, "#{gem_name}.gemspec")
      if File.exist?(gemspec_src)
        Gem::Specification.reset!
        Gem::Specification._loading_spec = nil
        load gemspec_src
        real_spec = Gem::Specification._loading_spec
        if real_spec && !real_spec.name.to_s.empty?
          wrapper_bindir = real_spec.bindir || "bin"
          File.write(spec_path, build_gemspec_content(real_spec, install_dir))
        else
          File.write(spec_path, gemspec_stub(gem_name, version, install_dir))
        end
      else
        File.write(spec_path, gemspec_stub(gem_name, version, install_dir))
      end
    else
      wrapper_bindir = "bin"
    end

    bin_src = File.join(install_dir, wrapper_bindir)
    if File.directory?(bin_src)
      Dir.children(bin_src).each do |exe|
        wrapper = File.join(bin_dir, exe)
        exe_path = File.join(bin_src, exe)
        File.write(wrapper, wrapper_script_for(exe_path))
        system("chmod", "+x", wrapper)
      end
    end

    puts "Successfully installed #{gem_full}"
    Gem::Specification.reset!
  ensure
    system("rm", "-rf", tmp)
  end
end

def build_gemspec_content(spec, install_dir = nil)
  lines = ["Gem::Specification.new do |s|"]
  lines << "  s.name    = #{spec.name.inspect}"
  lines << "  s.version = Gem::Version.new(#{spec.version.to_s.inspect})"
  lines << "  s.summary = #{spec.summary.to_s.inspect}"
  lines << "  s.description = #{spec.description.to_s.inspect}" unless spec.description.to_s.empty?
  lines << "  s.homepage = #{spec.homepage.to_s.inspect}"        unless spec.homepage.to_s.empty?
  lines << "  s.license  = #{spec.license.to_s.inspect}"         unless spec.license.to_s.empty?
  (spec.require_paths || ["lib"]).each { |rp|
    lines << "  s.require_paths = #{(spec.require_paths || ["lib"]).inspect}"
    break
  }
  (spec.runtime_dependencies || []).each do |dep|
    lines << "  s.add_runtime_dependency #{dep.name.inspect}, #{dep.requirement.to_s.inspect}"
  end
  executables = spec.executables || []
  if executables.empty? && install_dir
    bin_src = File.join(install_dir, "bin")
    executables = Dir.children(bin_src) if File.directory?(bin_src)
  end
  unless executables.empty?
    lines << "  s.executables = #{executables.inspect}"
  end
  if spec.bindir && spec.bindir != "bin"
    lines << "  s.bindir = #{spec.bindir.inspect}"
  end
  lines << "end"
  lines.join("\n") + "\n"
end

def resolve_gem_version(gem_name, version_spec)
  return nil unless version_spec
  # If the version spec looks like an exact version (starts with a digit), use it directly
  return version_spec if version_spec =~ /\A\d/

  # It's a constraint like "~> 1.0" — query the versions endpoint
  body = fetch_url("#{GEM_SERVER}/api/v1/versions/#{gem_name}.json")
  if body
    versions = body.scan(/"number"\s*:\s*"([^"]+)"/).flatten
    req = Gem::Requirement.new(version_spec)
    matching = versions.select do |v|
      begin
        req.satisfied_by?(Gem::Version.new(v))
      rescue StandardError
        false
      end
    end
    best = matching.sort_by { |v| v.split(".").map(&:to_i) }.last
    return best if best
  end

  # Fall back to latest via gems API
  body = fetch_url("#{GEM_SERVER}/api/v1/gems/#{gem_name}.json")
  return nil unless body
  body =~ /"version"\s*:\s*"([^"]+)"/ ? $1 : nil
end

def gem_install_remote_one(gem_name, version_spec)
  unless check_tool("curl") && check_tool("tar")
    STDERR.puts "ERROR: 'curl' and 'tar' are required for gem install"
    exit 1
  end

  home      = Gem.home
  gems_dir  = File.join(home, "gems")
  specs_dir = File.join(home, "specifications")
  bin_dir   = File.join(home, "bin")
  [home, gems_dir, specs_dir, bin_dir].each { |d| system("mkdir", "-p", d) unless File.directory?(d) }

  version = resolve_gem_version(gem_name, version_spec)
  puts "Fetching #{gem_name}..."
  unless version
    body = fetch_url("#{GEM_SERVER}/api/v1/gems/#{gem_name}.json")
    unless body
      STDERR.puts "ERROR: Could not fetch info for gem '#{gem_name}'"
      return false
    end
    unless body =~ /"version"\s*:\s*"([^"]+)"/
      STDERR.puts "ERROR: Could not parse version for gem '#{gem_name}'"
      return false
    end
    version = $1
  end

  gem_full = "#{gem_name}-#{version}"
  url      = "#{GEM_SERVER}/gems/#{gem_full}.gem"
  tmp      = "/tmp/stoned_gem_install_#{gem_name}_#{$$}"
  system("mkdir", "-p", tmp)
  begin
    gem_path = File.join(tmp, "#{gem_full}.gem")
    puts "Downloading #{url}..."
    unless system("curl", "-fsSL", "-o", gem_path, url)
      STDERR.puts "ERROR: Download failed for #{gem_name} #{version}"
      return false
    end
    install_gem_file(gem_path)
    true
  ensure
    system("rm", "-rf", tmp)
  end
end

def gem_install(names, opts = {})
  done    = {}
  pending = []

  names.each do |gem_name|
    if gem_name.end_with?(".gem") && File.exist?(gem_name)
      install_gem_file(File.expand_path(gem_name))
      # Mark as done; local file installs don't auto-fetch remote deps
      Gem::Specification.reset!
      base = File.basename(gem_name, ".gem").split("-")[0..-2].join("-")
      done[base] = true
    else
      pending << gem_name unless done.key?(gem_name)
    end
  end

  version_hint = opts[:version]
  no_deps      = opts[:no_deps]
  force        = opts[:force]

  until pending.empty?
    gem_name = pending.shift
    next if done.key?(gem_name)

    Gem::Specification.reset!
    existing = Gem::Specification.find_by_name(gem_name)
    if existing && !version_hint && !force
      done[gem_name] = true
      next
    end

    ok = gem_install_remote_one(gem_name, version_hint)
    version_hint = nil
    force = false
    done[gem_name] = true
    next unless ok
    next if no_deps

    Gem::Specification.reset!
    installed = Gem::Specification.find_by_name(gem_name)
    next unless installed
    (installed.runtime_dependencies || []).each do |dep|
      next if done.key?(dep.name)
      Gem::Specification.reset!
      next if Gem::Specification.find_by_name(dep.name)
      pending << dep.name
    end
  end
end

def gemspec_stub(name, version, install_dir)
  require_paths = []
  lib_dir = File.join(install_dir, "lib")
  require_paths << "lib" if File.directory?(lib_dir)
  require_paths = ["lib"] if require_paths.empty?

  exes = []
  bin_dir = File.join(install_dir, "bin")
  exes = Dir.children(bin_dir) if File.directory?(bin_dir)

  lines = []
  lines << "Gem::Specification.new do |s|"
  lines << "  s.name = #{name.inspect}"
  lines << "  s.version = Gem::Version.new(#{version.inspect})"
  lines << "  s.require_paths = #{require_paths.inspect}"
  lines << "  s.executables = #{exes.inspect}" unless exes.empty?
  lines << "end"
  lines.join("\n") + "\n"
end

def gem_build(gemspec_path)
  unless File.exist?(gemspec_path)
    STDERR.puts "ERROR: #{gemspec_path}: no such file"
    exit 1
  end

  unless check_tool("tar") && check_tool("gzip")
    STDERR.puts "ERROR: 'tar' and 'gzip' are required for gem build"
    exit 1
  end

  # Load the gemspec to get name/version
  Gem::Specification.reset!
  load File.expand_path(gemspec_path)
  spec = Gem::Specification._loading_spec
  unless spec && !spec.name.to_s.empty?
    STDERR.puts "ERROR: Could not load gemspec from #{gemspec_path}"
    exit 1
  end

  gem_name = "#{spec.name}-#{spec.version}.gem"
  source_root = File.dirname(File.expand_path(gemspec_path))
  tmp = "/tmp/stoned_gem_build_#{spec.name}_#{$$}"
  system("mkdir", "-p", tmp)

  begin
    # Build metadata (YAML-ish gemspec content)
    meta_path = File.join(tmp, "metadata")
    File.write(meta_path, build_metadata_yaml(spec))
    system("gzip", "-n", "-9", meta_path)  # produces metadata.gz

    # Build data.tar.gz from files
    files = spec.files
    if files.empty?
      # Auto-discover if files is empty
      files = Dir.glob(File.join(source_root, "lib/**/*.rb")).map { |f|
        f.sub(source_root + "/", "")
      }
    end
    gemspec_name = File.basename(gemspec_path)
    files += [gemspec_name] unless files.include?(gemspec_name)

    data_tar = File.join(tmp, "data.tar.gz")
    file_args = files.select { |f| File.exist?(File.join(source_root, f)) }
    system("tar", "-czf", data_tar, "-C", source_root, *file_args)

    # Compute checksums
    sha256_meta = `sha256sum #{tmp}/metadata.gz 2>/dev/null`.split(" ").first || ""
    sha256_data = `sha256sum #{data_tar} 2>/dev/null`.split(" ").first || ""

    checksums = "---\nmetadata.gz:\n  sha256: #{sha256_meta}\ndata.tar.gz:\n  sha256: #{sha256_data}\n"
    checksums_path = File.join(tmp, "checksums.yaml.gz")
    cs_raw = File.join(tmp, "checksums.yaml")
    File.write(cs_raw, checksums)
    system("gzip", "-n", "-9", cs_raw)

    # Pack everything into the .gem file (which is a tar)
    system("tar", "-cf", gem_name,
           "-C", tmp,
           "metadata.gz", "data.tar.gz", "checksums.yaml.gz")

    puts "Successfully built gem: #{gem_name}"
    puts "  Gem: #{File.expand_path(gem_name)}"
  ensure
    system("rm", "-rf", tmp)
  end
end

def build_metadata_yaml(spec)
  lines = []
  lines << "--- !ruby/object:Gem::Specification"
  lines << "name: #{spec.name}"
  lines << "version: !ruby/object:Gem::Version"
  lines << "  version: '#{spec.version}'"
  lines << "summary: #{spec.summary.to_s.inspect}"
  lines << "description: #{spec.description.to_s.inspect}"
  authors = spec.authors || []
  lines << "authors:"
  authors.each { |a| lines << "- #{a}" }
  lines << "email:"
  [spec.email].flatten.each { |e| lines << "- #{e}" }
  lines << "homepage: #{spec.homepage.to_s.inspect}"
  lines << "licenses:"
  [spec.license].flatten.compact.each { |l| lines << "- #{l}" }
  lines << "require_paths:"
  (spec.require_paths || ["lib"]).each { |rp| lines << "- #{rp}" }
  files = spec.files || []
  lines << "files:"
  files.each { |f| lines << "- #{f}" }
  deps = spec.runtime_dependencies || []
  if deps.any?
    lines << "dependencies:"
    deps.each do |dep|
      lines << "- !ruby/object:Gem::Dependency"
      lines << "  name: #{dep.name}"
      lines << "  requirement: !ruby/object:Gem::Requirement"
      lines << "    requirements:"
      lines << "    - - \"#{dep.requirement}\""
      lines << "  type: :runtime"
    end
  end
  lines.join("\n") + "\n"
end

def print_usage
  STDERR.puts "Usage: gem COMMAND [ARGS]"
  STDERR.puts ""
  STDERR.puts "Common commands:"
  STDERR.puts "  build GEMSPEC      Build a gem from a gemspec"
  STDERR.puts "  install GEMNAME    Install a gem"
  STDERR.puts "  list               List installed gems"
  STDERR.puts "  info GEM           Display gem information"
  STDERR.puts "  dependency GEM     List gem dependencies"
  STDERR.puts "  contents GEM       List files installed for a gem"
  STDERR.puts "  search PATTERN     Search installed gems"
  STDERR.puts "  specification GEM  Print an installed gemspec"
  STDERR.puts "  open GEM           Print the installed path for a gem"
  STDERR.puts "  unpack GEM         Copy an installed gem into the current directory"
  STDERR.puts "  which FEATURE      Print the installed path for a require target"
  STDERR.puts "  cleanup [GEM]      Remove old versions of installed gems"
  STDERR.puts "  outdated           List gems with newer versions"
  STDERR.puts "  update GEM         Update an installed gem"
  STDERR.puts "  env                Display RubyGems environment"
  STDERR.puts "  version            Display RubyGems version"
end

def option_value(flag_short, flag_long)
  ARGV.each_with_index do |arg, i|
    return ARGV[i + 1] if arg == flag_short || arg == flag_long
  end
  nil
end

def find_installed_spec(gem_name, version = nil)
  Gem::Specification.reset! if Gem::Specification.respond_to?(:reset!)
  if version && !version.empty?
    Gem::Specification.find_by_name(gem_name, version)
  else
    Gem::Specification.find_by_name(gem_name)
  end
end

def positional_args(args)
  names = []
  skip_next = false

  args.each do |arg|
    if skip_next
      skip_next = false
      next
    end

    if arg == "-v" || arg == "--version"
      skip_next = true
      next
    end

    next if arg.start_with?("-")
    names << arg
  end

  names
end

def refresh_bin_wrappers_for(spec)
  bin_dir = File.join(Gem.home, "bin")
  executables = spec.executables || []
  return if executables.empty?

  executables.each do |exe|
    wrapper = File.join(bin_dir, exe)
    replacement = Gem::Specification.find_all_by_name(spec.name)
      .sort_by(&:version)
      .reverse
      .find do |candidate|
        next false if candidate.full_name == spec.full_name

        candidate_exes = candidate.executables || []
        candidate_exes.include?(exe) &&
          File.exist?(File.join(candidate.gem_dir, candidate.bindir || "bin", exe))
      end

    if replacement
      exe_path = File.join(replacement.gem_dir, replacement.bindir || "bin", exe)
      File.write(wrapper, wrapper_script_for(exe_path))
      system("chmod", "+x", wrapper)
    elsif File.exist?(wrapper)
      File.delete(wrapper)
    end
  end
end

def find_installed_feature(feature)
  candidates = if feature.end_with?(".rb")
    [feature]
  else
    ["#{feature}.rb", feature]
  end

  Gem::Specification.all
    .sort_by(&:version)
    .reverse
    .each do |spec|
      (spec.require_paths || ["lib"]).each do |require_path|
        candidates.each do |candidate|
          full_path = File.join(spec.gem_dir, require_path, candidate)
          return full_path if File.file?(full_path)
        end
      end
    end

  nil
end

command = ARGV[0]

case command
when "build"
  gemspec = ARGV[1]
  if gemspec.nil?
    # Auto-find .gemspec in current dir
    specs = Dir.glob("*.gemspec")
    if specs.length == 1
      gemspec = specs.first
    elsif specs.empty?
      STDERR.puts "ERROR: No gemspec found in current directory"
      exit 1
    else
      STDERR.puts "ERROR: Multiple gemspecs found, specify one: #{specs.join(", ")}"
      exit 1
    end
  end
  gem_build(gemspec)

when "install", "i"
  names = positional_args(ARGV[1..])
  if names.empty?
    STDERR.puts "ERROR: Please specify a gem name"
    exit 1
  end
  version = option_value("-v", "--version")
  no_deps = ARGV.include?("--no-deps") || ARGV.include?("--ignore-dependencies")
  force   = ARGV.include?("--force")
  gem_install(names, version: version, no_deps: no_deps, force: force)

when "uninstall", "uni"
  names = positional_args(ARGV[1..])
  if names.empty?
    STDERR.puts "ERROR: Please specify a gem name"
    exit 1
  end
  version = option_value("-v", "--version")
  names.each do |gem_name|
    spec = find_installed_spec(gem_name, version)
    unless spec
      STDERR.puts "ERROR: gem '#{gem_name}' is not installed"
      next
    end
    puts "Removing #{spec.full_name}..."
    refresh_bin_wrappers_for(spec)
    system("rm", "-rf", spec.gem_dir)
    spec_file = File.join(Gem.home, "specifications", "#{spec.full_name}.gemspec")
    File.delete(spec_file) if File.exist?(spec_file)
    puts "Successfully uninstalled #{spec.full_name}"
    Gem::Specification.reset! if Gem::Specification.respond_to?(:reset!)
  end

when "list", "--list", "-l"
  pattern = ARGV[1]
  regex = pattern && !pattern.empty? ? Regexp.new(pattern) : nil
  puts "*** LOCAL GEMS ***"
  puts
  specs = Gem::Specification.all
  specs = specs.select { |spec| spec.name =~ regex } if regex
  if specs.empty?
    puts "(no gems installed)"
  else
    by_name = specs.group_by(&:name)
    by_name.keys.sort.each do |name|
      versions = by_name[name].map(&:version).map(&:to_s).join(", ")
      puts "#{name} (#{versions})"
    end
  end

when "env"
  case ARGV[1]
  when "home", "gemhome", "GEM_HOME"
    puts Gem.home
  when "path", "gempath", "GEM_PATH"
    puts Gem.path.join(File::PATH_SEPARATOR)
  when "version"
    puts Gem::VERSION
  when "remotesources"
    puts GEM_SERVER
  else
    print_gem_env
  end

when "-v", "--version", "version"
  puts Gem::VERSION

when "contents"
  gem_name = ARGV[1]
  if gem_name.nil? || gem_name.empty?
    STDERR.puts "ERROR: Please specify a gem name"
    exit 1
  end
  version = option_value("-v", "--version")

  spec = find_installed_spec(gem_name, version)
  unless spec
    STDERR.puts "ERROR: gem '#{gem_name}' is not installed"
    exit 1
  end

  entries = Dir.glob(File.join(spec.gem_dir, "**", "*")).select { |path| File.file?(path) }
  entries.sort.each { |path| puts path }

when "search"
  specs = Gem::Specification.all
  pattern = ARGV[1]
  regex = pattern && !pattern.empty? ? Regexp.new(pattern) : nil

  puts "*** LOCAL GEMS ***"
  puts

  matches = if regex
    specs.select { |spec| spec.name =~ regex }
  else
    specs
  end

  if matches.empty?
    puts "(no gems found)"
  else
    by_name = matches.group_by(&:name)
    by_name.keys.sort.each do |name|
      versions = by_name[name].map(&:version).map(&:to_s).sort.join(", ")
      puts "#{name} (#{versions})"
    end
  end

when "specification"
  gem_name = ARGV[1]
  if gem_name.nil? || gem_name.empty?
    STDERR.puts "ERROR: Please specify a gem name"
    exit 1
  end
  version = option_value("-v", "--version")

  spec = find_installed_spec(gem_name, version)
  unless spec
    STDERR.puts "ERROR: gem '#{gem_name}' is not installed"
    exit 1
  end

  print build_gemspec_content(spec)

when "open"
  gem_name = ARGV[1]
  if gem_name.nil? || gem_name.empty?
    STDERR.puts "ERROR: Please specify a gem name"
    exit 1
  end
  version = option_value("-v", "--version")

  spec = find_installed_spec(gem_name, version)
  unless spec
    STDERR.puts "ERROR: gem '#{gem_name}' is not installed"
    exit 1
  end

  puts spec.gem_dir

when "which"
  feature = ARGV[1]
  if feature.nil? || feature.empty?
    STDERR.puts "ERROR: Please specify a feature name"
    exit 1
  end

  path = find_installed_feature(feature)
  unless path
    STDERR.puts "ERROR: Can't find Ruby library file or shared library #{feature}"
    exit 1
  end

  puts path

when "unpack"
  gem_name = ARGV[1]
  if gem_name.nil? || gem_name.empty?
    STDERR.puts "ERROR: Please specify a gem name"
    exit 1
  end
  version = option_value("-v", "--version")

  spec = find_installed_spec(gem_name, version)
  unless spec
    STDERR.puts "ERROR: gem '#{gem_name}' is not installed"
    exit 1
  end

  target = File.expand_path(spec.full_name, Dir.pwd)
  if File.exist?(target)
    STDERR.puts "ERROR: #{spec.full_name} already exists"
    exit 1
  end

  unless system("cp", "-R", spec.gem_dir, target)
    STDERR.puts "ERROR: Failed to unpack #{spec.full_name}"
    exit 1
  end
  puts "Unpacked gem: '#{target}'"

when "help", "-h", "--help", nil
  print_usage

when "update"
  names = positional_args(ARGV[1..])
  if names.empty?
    STDERR.puts "Usage: gem update GEM [GEM2 ...]"
    exit 1
  end
  unless check_tool("curl") && check_tool("tar")
    STDERR.puts "ERROR: 'curl' and 'tar' are required for gem update"
    exit 1
  end
  names.each do |gem_name|
    current_spec = find_installed_spec(gem_name)
    current_ver  = current_spec ? current_spec.version.to_s : nil

    puts "Fetching latest version info for #{gem_name}..."
    body = fetch_url("#{GEM_SERVER}/api/v1/gems/#{gem_name}.json")
    unless body
      STDERR.puts "ERROR: Could not fetch info for gem '#{gem_name}'"
      next
    end
    unless body =~ /"version"\s*:\s*"([^"]+)"/
      STDERR.puts "ERROR: Could not parse version for gem '#{gem_name}'"
      next
    end
    latest = $1

    if current_ver && current_ver == latest
      puts "#{gem_name} #{current_ver} is already the latest version"
      next
    end

    puts "Updating #{gem_name} from #{current_ver || "(not installed)"} to #{latest}..."
    gem_install([gem_name], version: latest)
  end

when "cleanup"
  Gem::Specification.reset!
  all_specs = Gem::Specification.all
  by_name   = {}
  all_specs.each do |spec|
    by_name[spec.name] ||= []
    by_name[spec.name] << spec
  end

  removed = 0
  by_name.each do |name, specs|
    next if specs.length <= 1
    # Sort ascending by version segments so the last element is the latest
    sorted = specs.sort_by { |s| s.version.to_s.split(".").map(&:to_i) }
    sorted[0..-2].each do |old_spec|
      puts "Removing #{old_spec.full_name}"
      refresh_bin_wrappers_for(old_spec)
      system("rm", "-rf", old_spec.gem_dir)
      spec_file = File.join(Gem.home, "specifications", "#{old_spec.full_name}.gemspec")
      File.delete(spec_file) if File.exist?(spec_file)
      removed += 1
    end
  end

  if removed > 0
    puts "Cleaned up #{removed} old gem version#{removed == 1 ? "" : "s"}"
    Gem::Specification.reset!
  else
    puts "Nothing to clean up"
  end

when "fetch"
  gem_name = positional_args(ARGV[1..]).first
  if gem_name.nil? || gem_name.empty?
    STDERR.puts "ERROR: Please specify a gem name"
    exit 1
  end
  unless check_tool("curl")
    STDERR.puts "ERROR: 'curl' is required for gem fetch"
    exit 1
  end

  version = option_value("-v", "--version")
  puts "Fetching #{gem_name}..."
  unless version
    body = fetch_url("#{GEM_SERVER}/api/v1/gems/#{gem_name}.json")
    unless body
      STDERR.puts "ERROR: Could not fetch info for gem '#{gem_name}'"
      exit 1
    end
    unless body =~ /"version"\s*:\s*"([^"]+)"/
      STDERR.puts "ERROR: Could not parse version for gem '#{gem_name}'"
      exit 1
    end
    version = $1
  end

  gem_file = "#{gem_name}-#{version}.gem"
  url      = "#{GEM_SERVER}/gems/#{gem_file}"
  unless system("curl", "-fsSL", "-o", gem_file, url)
    STDERR.puts "ERROR: Failed to download #{gem_name} #{version}"
    exit 1
  end
  puts "Downloaded #{gem_file}"

when "pristine"
  names = positional_args(ARGV[1..])
  if names.empty?
    STDERR.puts "Usage: gem pristine GEM [GEM2 ...]"
    exit 1
  end
  unless check_tool("curl") && check_tool("tar")
    STDERR.puts "ERROR: 'curl' and 'tar' are required for gem pristine"
    exit 1
  end
  puts "Restoring gems to pristine condition..."
  names.each do |gem_name|
    version = option_value("-v", "--version")
    spec = find_installed_spec(gem_name, version)
    unless spec
      STDERR.puts "#{gem_name} is not installed"
      next
    end
    puts "Restoring #{spec.full_name}"
    gem_install([gem_name], version: spec.version.to_s, force: true, no_deps: true)
  end

when "outdated"
  Gem::Specification.reset!
  all_specs = Gem::Specification.all
  by_name   = {}
  all_specs.each do |spec|
    by_name[spec.name] ||= []
    by_name[spec.name] << spec
  end

  unless check_tool("curl")
    STDERR.puts "ERROR: 'curl' is required for gem outdated"
    exit 1
  end

  puts "Checking for newer versions..."
  outdated = []
  by_name.each do |name, specs|
    latest_installed = specs.sort_by { |s| s.version.to_s.split(".").map(&:to_i) }.last
    body = fetch_url("#{GEM_SERVER}/api/v1/gems/#{name}.json")
    next unless body
    next unless body =~ /"version"\s*:\s*"([^"]+)"/
    remote = $1
    if remote != latest_installed.version.to_s
      outdated << { name: name, installed: latest_installed.version.to_s, latest: remote }
    end
  end

  if outdated.empty?
    puts "No gems are outdated"
  else
    puts "Outdated gems:"
    outdated.sort_by { |g| g[:name] }.each do |g|
      puts "  #{g[:name]} (newest #{g[:latest]}, installed #{g[:installed]})"
    end
  end

when "info"
  gem_name = ARGV[1]
  if gem_name.nil? || gem_name.empty?
    STDERR.puts "ERROR: Please specify a gem name"
    exit 1
  end
  version = option_value("-v", "--version")
  spec = find_installed_spec(gem_name, version)
  unless spec
    STDERR.puts "ERROR: gem '#{gem_name}' is not installed"
    exit 1
  end
  puts "#{spec.name} (#{spec.version})"
  puts "  Summary:      #{spec.summary}"
  puts "  Homepage:     #{spec.homepage}" unless spec.homepage.to_s.empty?
  puts "  License:      #{spec.license}"  unless spec.license.to_s.empty?
  puts "  Installed at: #{spec.gem_dir}"
  deps = spec.runtime_dependencies || []
  if deps.any?
    puts "  Dependencies:"
    deps.each { |d| puts "    #{d.name} (#{d.requirement})" }
  end

when "dependency", "dep"
  names = positional_args(ARGV[1..])
  if names.empty?
    STDERR.puts "ERROR: Please specify a gem name"
    exit 1
  end
  version = option_value("-v", "--version")
  names.each do |gem_name|
    spec = find_installed_spec(gem_name, version)
    unless spec
      STDERR.puts "Gem #{gem_name} is not installed"
      next
    end
    puts "Gem #{spec.full_name}"
    deps = spec.runtime_dependencies || []
    if deps.empty?
      puts "  (no dependencies)"
    else
      deps.each { |d| puts "  #{d.name} (#{d.requirement})" }
    end
  end

when "push"
  STDERR.puts "ERROR: gem push requires a valid API key and network access to rubygems.org"
  STDERR.puts "Set GEM_HOST_API_KEY or use `gem signin` with a real RubyGems client."
  exit 1

when "exec"
  STDERR.puts "gem #{command}: not yet implemented"
  exit 1

else
  STDERR.puts "ERROR: Unknown command '#{command}'"
  print_usage
  exit 1
end
